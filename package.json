{
  "name": "node-backend-sablon",
  "version": "1.0.0",
  "description": "Fejlesztoi kornyezet Node.js backend projektekhez: ESLint, Prettier, EditorConfig, VS Code beallitasok",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "node --watch --env-file-if-exists=.env index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
