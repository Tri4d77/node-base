# Ez a MINTA. Másold le .env néven, és töltsd ki az értékeket:
#     Windows (PowerShell):  Copy-Item .env.minta .env
#     macOS / Linux:         cp .env.minta .env
#
# A .env SOHA nem kerül verziókezelőbe (lásd .gitignore) — ez a fájl igen,
# hogy a munkatársad lássa, milyen kulcsokat kell beállítania.
#
# Beolvasás: a package.json „dev” szkriptje a --env-file-if-exists kapcsolót
# használja, így .env nélkül is elindul a program.

# A port, amelyen a szerver figyel. FIGYELEM: szövegként érkezik, Number() kell hozzá.
PORT=3000

# A futtatási mód: development · test · production
NODE_ENV=development
